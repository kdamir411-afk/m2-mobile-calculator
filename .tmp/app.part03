 type="number" step="0.001" inputmode="decimal" placeholder="Напр. 2.3"></div></div><div class="modalCheck"><label>Доступная укладка</label><div class="checkrow"><label class="checkpill"><input id="newLayoutStraight" type="checkbox" checked>Прямая</label><label class="checkpill"><input id="newLayoutDeck" type="checkbox" checked>Палубная</label><label class="checkpill"><input id="newLayoutHerringbone" type="checkbox" checked>Ёлочка</label></div></div><div class="modalActions"><button id="newProductCancel" class="secondary">Отмена</button><button id="newProductSave">Добавить</button></div></div></div>
<script>
(()=>{'use strict';
const $=id=>document.getElementById(id),safe=v=>{const n=Number(String(v??'').replace(',','.'));return Number.isFinite(n)?Math.max(0,n):0},money=n=>new Intl.NumberFormat('ru-RU',{maximumFractionDigits:0}).format(safe(n)),num=n=>new Intl.NumberFormat('ru-RU',{maximumFractionDigits:3}).format(safe(n)),esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
const trash='<svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 10v6M14 10v6"/></svg>';$('clearFloor').innerHTML=trash;$('clearWall').innerHTML=trash;
const NO_CAT='Без категории';
const LAYOUTS={straight:{label:'Прямая',waste:5},deck:{label:'Палубная',waste:5},herringbone:{label:'Ёлочка',waste:10}};
const layoutKeys=Object.keys(LAYOUTS);
function load(k,f){try{const x=JSON.parse(localStorage.getItem(k));return x??f}catch{return f}}
function catValue(v){return String(v??'').trim()}
function normalizeLayouts(v){const a=Array.isArray(v)?v.filter(x=>layoutKeys.includes(x)):[];return a.length?[...new Set(a)]:[...layoutKeys]}
function layoutLabel(k){return LAYOUTS[k]?.label||LAYOUTS.straight.label}
function defaultWaste(k){return safe(LAYOUTS[k]?.waste??5)}
function firstLayout(p){return normalizeLayouts(p?.layouts)[0]||'straight'}
let products=load('m2_products',[]);if(!Array.isArray(products))products=[];products=products.map(p=>({category:catValue(p.category),name:String(p.name??''),price:safe(p.price),packArea:safe(p.packArea??p.packageArea??p.pack??0),layouts:normalizeLayouts(p.layouts)}));
let savedCats=load('m2_categories_v1',[]);if(!Array.isArray(savedCats))savedCats=[];let categoryNames=[...new Set([...savedCats.map(catValue),...products.map(p=>p.category).filter(Boolean)].filter(Boolean))];
function validProduct(i){i=Number(i);return Number.isInteger(i)&&i>=0&&i<products.length?i:-1}
function blankFloor(){return{title:'',area:0,product:-1,layout:'straight',waste:5,discount:0}}
function blankWall(){return{title:'',height:0,width:0,product:-1,layout:'straight',waste:5,discount:0}}
function normalizeItem(x,kind){const pidx=validProduct(x.product),p=productObj(pidx),allowed=normalizeLayouts(p?.layouts),layout=allowed.includes(x.layout)?x.layout:(allowed[0]||'straight'),fallbackWaste=x.waste===undefined||x.waste===null||x.waste===''?defaultWaste(layout):safe(x.waste);return kind==='wall'?{title:String(x.title||x.label||''),height:safe(x.height),width:safe(x.width),product:pidx,layout,waste:Math.min(100,fallbackWaste),discount:Math.min(100,safe(x.discount))}:{title:String(x.title||''),area:safe(x.area||(safe(x.length)*safe(x.width))),product:pidx,layout,waste:Math.min(100,fallbackWaste),discount:Math.min(100,safe(x.discount))}}
let floorItems=load('m2_floor_sizes_v1',[]);if(!Array.isArray(floorItems)||!floorItems.length)floorItems=[blankFloor()];floorItems=floorItems.map(x=>normalizeItem(x,'floor'));
let wallItems=load('m2_walls_v2',[]);if(!Array.isArray(wallItems)||!wallItems.length)wallItems=[blankWall()];wallItems=wallItems.map(x=>normalizeItem(x,'wall'));
let history=load('m2_history',[]);if(!Array.isArray(history))history=[];let calcMode=localStorage.getItem('m2_calc_mode')||(localStorage.getItem('m2_dimension_mode')==='1'?'dimension':'manual');let pendingSave=null,lastTab='history',pickerTarget={kind:'floor',index:0},pickerCategory='Все',selectedCategory=categoryNames[0]||'',categoryModalMode='add';
function actualCategories(){const out=[...categoryNames];if(products.some(p=>!p.category))out.push(NO_CAT);return [...new Set(out)]}
function persist(){localStorage.setItem('m2_products',JSON.stringify(products));localStorage.setItem('m2_categories_v1',JSON.stringify(categoryNames));localStorage.setItem('m2_floor_sizes_v1',JSON.stringify(floorItems));localStorage.setItem('m2_walls_v2',JSON.stringify(wallItems));localStorage.setItem('m2_history',JSON.stringify(history));localStorage.setItem('m2_calc_mode',calcMode);localStorage.setItem('m2_dimension_mode',calcMode==='dimension'?'1':'0')}
function toast(t){const d=document.createElement('div');d.className='toast';d.textContent=t;document.body.appendChild(d);setTimeout(()=>d.remove(),1500)}
function productObj(i){const idx=validProduct(i);return idx>=0?products[idx]:null}
function productText(i){const p=productObj(i);if(!p)return'<span><b>Выбрать товар</b></span><span>›</span>';const pack=p.packArea?` · ${num(p.packArea)} м²/уп.`:' · упаковка не указана';return`<span><b>${esc(p.name||'Без названия')}</b><span class="meta">${esc(p.category||NO_CAT)} · ${money(p.price)} ₸/м²${pack}</span></span><span>›</span>`}
function showTab(tab){if(tab==='detail')return;['calc','history','settings'].forEach(x=>$(x+'Screen').classList.toggle('active',x===tab));$('detailScreen').classList.remove('active');$('bottomNav').classList.remove('hidden');document.querySelectorAll('.navbtn').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));if(tab==='history')renderHistory();if(tab==='settings')renderSettings();if(tab==='calc')renderCalc();window.scrollTo(0,0)}
function layoutChecks(p,i){return layoutKeys.map(k=>`<label class="checkpill"><input data-playout="${i}" data-layout="${k}" type="checkbox" ${p.layouts.includes(k)?'checked':''}>${LAYOUTS[k].label}</label>`).join('')}
function renderSettings(){
  $('setManual').classList.toggle('active',calcMode==='manual');$('setDimension').classList.toggle('active',calcMode==='dimension');
  const cats=actualCategories();if(selectedCategory&&!cats.includes(selectedCategory))selectedCategory=cats[0]||'';if(!selectedCategory&&cats.length)selectedCategory=cats[0];
  const bar=$('settingsCategories');bar.innerHTML='';cats.forEach(cat=>{const b=document.createElement('button');b.type='button';b.className='catbtn'+(cat===selectedCategory?' active':'');b.textContent=cat;b.onclick=()=>{readVisibleProducts();selectedCategory=cat;renderSettings()};bar.appendChild(