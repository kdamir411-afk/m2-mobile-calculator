/span><b>${money(p.price)} ₸/м²</b></div>${c.packArea>0?`<div class="line"><span>В упаковке</span><b>${num(c.packArea)} м²</b></div><div class="line"><span>Упаковки</span><b>${c.packages} уп.</b></div><div class="line"><span>Фактический метраж</span><b>${num(c.actualArea)} м²</b></div>`:''}<div class="line"><span>Сумма</span><b>${money(c.base)} ₸</b></div>${c.discount?`<div class="line"><span>Скидка</span><b>${c.discount}%</b></div>`:''}<div class="line"><span>Итого</span><b class="final">${money(c.total)} ₸</b></div></div>`});h+=`<div class="card"><div class="line"><span>Общая площадь</span><b>${num(x.area)} м²</b></div><div class="line"><span>С учётом запаса</span><b>${num(totalWasteArea)} м²</b></div>${totalDiscount>0?`<div class="line"><span>Сумма до скидки</span><b>${money(totalBefore)} ₸</b></div><div class="line"><span>Общая скидка</span><b>${money(totalDiscount)} ₸</b></div>`:''}<div class="line"><span>Итого</span><b class="final">${money(totalAfter)} ₸</b></div></div>`}else h+='<div class="card small">Старая запись сохранена в прежнем формате.</div>';h+=`<div class="actions"><button class="secondary" data-copyhist="${i}">Скопировать</button><button class="danger" data-delhist="${i}">Удалить</button></div>`;$('detailContent').innerHTML=h;document.querySelectorAll('.screen').forEach(e=>e.classList.remove('active'));$('detailScreen').classList.add('active');$('bottomNav').classList.add('hidden');window.scrollTo(0,0)}
function clearCurrent(kind,ask=true){if(ask&&!confirm('Очистить текущий расчёт?'))return;if(kind==='floor')floorItems=[blankFloor()];else wallItems=[blankWall()];persist();renderCalc();window.scrollTo({top:0,behavior:'smooth'})}
$('bottomNav').onclick=e=>{const b=e.target.closest('[data-tab]');if(b)showTab(b.dataset.tab)};
$('setManual').onclick=()=>{calcMode='manual';persist();renderSettings()};$('setDimension').onclick=()=>{calcMode='dimension';persist();renderSettings()};
$('categoryPanel').oninput=readVisibleProducts;$('categoryPanel').onchange=readVisibleProducts;
$('categoryPanel').onclick=e=>{const b=e.target.closest('[data-pdel]');if(!b)return;readVisibleProducts();const del=+b.dataset.pdel;products.splice(del,1);[floorItems,wallItems].forEach(arr=>arr.forEach(x=>x.product=x.product===del?-1:x.product>del?x.product-1:x.product));persist();renderSettings();renderCalc()};
$('addCategory').onclick=()=>openCategoryModal('add');$('addProduct').onclick=openNewProduct;$('saveProducts').onclick=()=>{readVisibleProducts();persist();renderSettings();renderCalc();toast('Товары сохранены')};
$('categoryCancel').onclick=closeCategoryModal;$('categorySave').onclick=saveCategory;$('categoryModal').onclick=e=>{if(e.target===$('categoryModal'))closeCategoryModal()};$('newProductCancel').onclick=closeNewProduct;$('newProductSave').onclick=saveNewProduct;$('newProductModal').onclick=e=>{if(e.target===$('newProductModal'))closeNewProduct()};
$('addFloor').onclick=()=>{floorItems.push(blankFloor());persist();renderFloor()};
$('floorList').oninput=e=>{const d=e.target.dataset;let i=d.ftitle??d.farea??d.fwaste??d.fdiscount;if(i===undefined)return;i=+i;if(d.ftitle!==undefined){floorItems[i].title=e.target.value;const h=document.querySelector(`[data-fhead="${i}"]`);if(h)h.textContent=e.tar