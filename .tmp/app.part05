>${num(c.wasteArea)} м²</b></div><div class="resultbox"><span>Упаковки</span><b data-${prefix}packs="${i}">${packKnown?c.packages+' уп.':'—'}</b></div><div class="resultbox"><span>Фактический метраж</span><b data-${prefix}actual="${i}">${packKnown?num(c.actualArea)+' м²':'—'}</b></div><div class="resultbox"><span>Стоимость</span><b data-${prefix}t="${i}" class="final">${money(c.total)} ₸</b></div></div>${c.p&&!packKnown?'<div class="calcHint warn">У этого товара не указан метраж упаковки. Пока стоимость считается по площади с запасом.</div>':''}`}
function renderFloor(){const list=$('floorList');list.innerHTML='';floorItems.forEach((x,i)=>{const p=productObj(x.product);if(p&&!normalizeLayouts(p.layouts).includes(x.layout)){x.layout=firstLayout(p);x.waste=defaultWaste(x.layout)}const c=floorCalc(x),d=document.createElement('div');d.className='sizecard';d.innerHTML=`<div class="head"><b class="sizeTitle" data-fhead="${i}">${esc(x.title||`Расчёт ${i+1}`)}</b><div class="actions" style="margin:0"><button class="secondary" data-fdup="${i}">Дублировать</button>${floorItems.length>1?`<button class="danger" data-fdel="${i}">×</button>`:''}</div></div><label>Название (необязательно)</label><input data-ftitle="${i}" value="${esc(x.title)}"><label>Площадь, м²</label><input data-farea="${i}" type="number" step="0.01" inputmode="decimal" value="${x.area?x.area:''}" placeholder="0"><label>Товар</label><button type="button" class="productpick" data-fpick="${i}">${productText(x.product)}</button>${p?`<div class="grid2"><div><label>Укладка</label><select data-flayout="${i}">${layoutOptions(p,x.layout)}</select></div><div><label>Запас, %</label><input data-fwaste="${i}" type="number" min="0" max="100" step="0.1" inputmode="decimal" value="${safe(x.waste)}"></div></div><div class="calcHint">Рекомендация: ${layoutLabel(x.layout)} — ${defaultWaste(x.layout)}%. Процент можно изменить вручную.</div>`:''}<label>Скидка, %</label><input data-fdiscount="${i}" type="number" min="0" max="100" step="0.1" inputmode="decimal" value="${x.discount?x.discount:''}" placeholder="0"><div class="dimresult">${calcResultHtml(c,'f',i)}</div>`;list.appendChild(d)});persist();calcFloor()}
function calcFloor(){let area=0,wasteArea=0,total=0;floorItems.forEach((x,i)=>{const c=floorCalc(x);area+=c.area;wasteArea+=c.wasteArea;total+=c.total;const wa=document.querySelector(`[data-fwarea="${i}"]`),pk=document.querySelector(`[data-fpacks="${i}"]`),ac=document.querySelector(`[data-factual="${i}"]`),t=document.querySelector(`[data-ft="${i}"]`);if(wa)wa.textContent=num(c.wasteArea)+' м²';if(pk)pk.textContent=c.p&&c.packArea>0?c.packages+' уп.':'—';if(ac)ac.textContent=c.p&&c.packArea>0?num(c.actualArea)+' м²':'—';if(t)t.textContent=money(c.total)+' ₸'});$('floorArea').textContent=num(area)+' м²';$('floorWasteArea').textContent=num(wasteArea)+' м²';$('floorTotal').textContent=money(total)+' ₸';return{area,wasteArea,total}}
function renderWalls(){const list=$('wallList');list.innerHTML='';wallItems.forEach((x,i)=>{const p=productObj(x.product);if(p&&!normalizeLayouts(p.layouts).includes(x.layout)){x.layout=firstLayout(p);x.waste=defaultWaste(x.layout)}const c=wallCalc(x),d=document.createElement('div');d.className='sizecard';d.innerHTML=`<div class="head"><b class="sizeTitle" data-whead="${i}">${esc(x.title||`Размеры ${i+1}`)}</b><div class="actions" style="margin:0"><button class="secondary" data-wdup="${i}">Дублировать</button>${wallItems.length>1?`<button class="danger" data-wdel="${i}">×</button>`:''}</div></div><label>Название (необязательно)</label><input data-wtitle="${i}" value="${esc(x.title)}"><div class="grid2"><div><label>Высота, м</label><input data-wheight="${i}" type="number" step="0.01" inputmode="decimal" value="${x.height?x.height:''}" placeholder="0"></div><div><label>Ширина, м</label><input data-wwidth="${i}" type="number" step="0.01" inputmode="decimal" value="${x.width?x.width:''}" placeholder="0"></div></div><label>Товар</label><button type="button" class="productpick" data-wpick="${i}">${productText(x.product)}</button>${p?`<div class="grid2"><div><label>Укладка</label><select data-wlayout="${i}">${layoutOptions(p,x.layout)}</select></div><div><label>Запас, %</label><input data-wwaste="${i}" type="number" min="0" max="100" step="0.1" inputmode="decimal" value="${safe(x.waste)}"></div></div><div class="calcHint">Рекомендация: ${layoutLabel(x.layout)} — ${defaultWaste(x.layout)}%. Процент можно изменить вручную.</div>`:''}<label>Скидка, %</label><input data-wdiscount="${i}" type="number" min="0" max="100" step="0.1" inputmode="decimal" value="${x.discount?x.discount:''}" placeholder="0"><div class="dimresult"><div class="line small"><span>Площадь</span><b data-wa="${i}">${num(c.area)} м²</b></div>${calcResultHtml(c,'w',i)}</div>`;list.appendChild(d)});persist();calcWalls()}
function calcWalls(){let area=0,wasteArea=0,total=0;wallItems.forEach((x,i)=>{const c=wallCalc(x);area+=c.area;wasteArea+=c.wasteArea;total+=c.total;const a=document.querySelector(`[data-wa="${i}"]`),wa=document.querySelector(`[data-wwarea="${i}"]`),pk=document.querySelector(`[data-wpacks="${i}"]`),ac=document.querySelector(`[data-wactual="${i}"]`),t=document.querySelector(`[data-wt="${i}"]`);if(a)a.textContent=num(c.area)+' м²';if(wa)wa.textContent=num(c.wasteArea)+' м²';if(pk)pk.textContent=c.p&&c.packArea>0?c.packages+' уп.':'—';if(ac)ac.textContent=c.p&&c.packArea>0?num(c.actualArea)+' м²':'—';if(t)t.textContent=money(c.total)+' ₸'});$('wallArea').textContent=num(area)+' м²';$('wallWasteArea').textContent=num(wasteArea)+' м²';$('wallTotal').textContent=money(total)+' ₸';return{area,wasteArea,total}}
function renderCalc(){const floor=calcMode==='manual';$('manualCalc').classList.toggle('hidden',!floor);$('dimensionCalc').classList.toggle('hidden',floor);floor?renderFloor():renderWalls()}
function openPicker(kind,index){pickerTarget={kind,index};const arr=kind==='floor'?floorItems:wallItems,p=productObj(arr[index]?.product);pickerCategory=p?(p.category||NO_CAT):'Все';$('pickerSearch').value='';$('productModal').classList.remove('hidden');renderPicker()}
function closePicker(){$('productModal').classList.add('hidden')}
function pickerSelected(){const arr=pickerTarget.kind==='floor'?floorItems:wallItems;return validProduct(arr[pickerTarget.index]?.product)}
function renderPicker(){const cats=['Все',...actualCategories()],bar=$('pickerCategories');bar.innerHTML='';cats.forEach(cat=>{const b=document.createElement('button');b.type='button';b.c