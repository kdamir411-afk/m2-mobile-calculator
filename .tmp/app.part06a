lassName='catbtn'+(cat===pickerCategory?' active':'');b.textContent=cat;b.onclick=()=>{pickerCategory=cat;renderPicker()};bar.appendChild(b)});const q=$('pickerSearch').value.trim().toLowerCase(),selected=pickerSelected();let rows=products.map((p,i)=>({p,i}));if(q)rows=rows.filter(x=>((x.p.name||'')+' '+(x.p.category||'')).toLowerCase().includes(q));else if(pickerCategory!=='Все')rows=rows.filter(x=>(x.p.category||NO_CAT)===pickerCategory);const list=$('pickerList');list.innerHTML='';if(!rows.length){list.innerHTML='<div class="small" style="padding:16px 2px">Товары не найдены.</div>';return}rows.forEach(({p,i})=>{const b=document.createElement('button');b.type='button';b.className='pickeritem'+(i===selected?' selected':'');const meta=[p.category||NO_CAT,p.packArea?`${num(p.packArea)} м²/уп.`:'упаковка не указана',normalizeLayouts(p.layouts).map(layoutLabel).join(', ')].join(' · ');b.innerHTML=`<span><b>${esc(p.name||'Без названия')}</b><span class="meta">${esc(meta)}</span></span><span class="pickerprice">${money(p.price)} ₸/м²</span>`;b.onclick=()=>{const arr=pickerTarget.kind==='floor'?floorItems:wallItems;if(arr[pickerTarget.index]){arr[pickerTarget.index].product=i;arr[pickerTarget.index].layout=firstLayout(p);arr[pickerTarget.index].waste=defaultWaste(arr[pickerTarget.index].layout)}persist();closePicker();renderCalc()};list.appendChild(b)})}
function snapshot(kind){const arr=kind==='floor'?floorItems:wallItems,totals=kind==='floor'?calcFloor():calcWalls();return{type:kind,items:arr.map(x=>({...x,productSnapshot:productObj(x.product)?{...productObj(x.product)}:null})),...totals}}
function calcSaved(z,type){const p=z.productSnapshot||productObj(z.product)||{name:'',category:'',price:0,packArea:0,layouts:layoutKeys},area=type==='wall'?safe(z.height)*safe(z.width):safe(z.area),layout=z.layout||firstLayout(p),waste=z.waste===undefined?0:safe(z.waste);return calcCore(area,p,layout,waste,z.discount)}
function textSnapshot(x){let out=['Расчёт заказа',''],ta=0,tw=0,totalBefore=0,totalDiscount=0,totalAfter=0;(x.items||[]).forEach((z,i)=>{const p=z.productSnapshot||productObj(z.product)||{name:'',category:'',price:0,packArea:0,layouts:layoutKeys},c=calcSaved(z,x.type);ta+=c.area;tw+=c.wasteArea;totalBefore+=c.base;totalDiscount+=c.discountSum;totalAfter+=c.total;out.push(z.title||`Размеры ${i+1}`);if(x.type==='wall')out.push(`Высота: ${num(z.height)} м`,`Ширина: ${num(z.width)} м`);out.push(`Площадь: ${num(c.area)} м²`,`Укладка: ${layoutLabel(c.layout)}`,`Запас: ${c.waste}%`,`Площадь с запасом: ${num(c.wasteArea)} м²`,`Категория: ${p.category||NO_CAT}`,`Товар: ${p.name||'Без названия'}`,`Цена: ${money(p.price)} ₸/м²`);if(c.packArea>0)out.push(`В упаковке: ${num(c.packArea)} м²`,`Количество: ${c.packages} уп.`,`Фактический метраж: ${num(c.actualArea)} м²`);out.push(`Сумма: ${money(c.base)} ₸`);if(c.discount)out.push(`Скидка: ${c.discount}%`);out.push(`Итого: ${money(c.total)} ₸`,'')});out.push('Общая площадь: '+num(ta)+' м²','С учётом запаса: '+num(tw)+' м²');if(totalDiscount>0)out.push('Сумма до скидки: '+money(totalBefore)+' ₸','Общая скидка: '+money(totalDiscount)+' ₸');out.push('Итого: '+money(totalAfter)+' ₸');if(x.note)out.push('','Заметка: '+x.note);return out.join('\n')}
