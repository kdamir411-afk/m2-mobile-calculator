<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0d0d0f">
<meta name="apple-mobile-web-app-capable" content="yes">
<link rel="manifest" href="manifest.json">
<title>Калькулятор м²</title>
<style>
:root{--bg:#0d0d0f;--card:#17171b;--card2:#202026;--text:#f5f5f7;--muted:#9a9aa3;--border:#303038;--good:#8ee6a5;--red:#ff6868}
*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",sans-serif}body{padding:env(safe-area-inset-top) 14px calc(92px + env(safe-area-inset-bottom))}main{max-width:720px;margin:auto;padding:18px 0}h1{font-size:28px;margin:0 0 5px}.sub,.small{color:var(--muted);font-size:13px;line-height:1.4}.sub{margin-bottom:18px}.card,.sizecard{background:var(--card);border:1px solid var(--border);border-radius:18px;padding:14px;margin-bottom:14px}.sizecard{background:var(--card2)}.head,.line,.actions{display:flex;align-items:center;gap:10px}.head,.line{justify-content:space-between}.line{margin-top:9px}.actions{flex-wrap:wrap;margin-top:13px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}label{display:block;color:var(--muted);font-size:13px;margin:8px 0 6px}input,textarea,select{width:100%;min-height:48px;border:1px solid var(--border);background:var(--card2);color:var(--text);border-radius:13px;padding:11px;font-size:16px;outline:none}select{appearance:none;-webkit-appearance:none;background-image:linear-gradient(45deg,transparent 50%,#aaa 50%),linear-gradient(135deg,#aaa 50%,transparent 50%);background-position:calc(100% - 18px) 20px,calc(100% - 13px) 20px;background-size:5px 5px,5px 5px;background-repeat:no-repeat;padding-right:36px}textarea{font-family:inherit;resize:vertical;min-height:80px}.sizecard input,.sizecard select{background:#17171b}button{border:0;border-radius:12px;padding:11px 13px;min-height:42px;font-size:14px;font-weight:650;background:#fff;color:#111}.secondary{background:var(--card2);color:var(--text);border:1px solid var(--border)}.danger{background:transparent;color:#ff8c8c;border:1px solid var(--border)}.trash{width:44px;min-width:44px;padding:0;display:inline-flex;align-items:center;justify-content:center;background:rgba(255,80,80,.08);color:var(--red);border:1px solid rgba(255,104,104,.28)}.trash svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.final{color:var(--good);font-size:20px;font-weight:750}.pname{font-weight:700}.historyrow{padding:13px 0;border-bottom:1px solid var(--border);cursor:pointer}.historyrow:last-child{border:0}.historyrow:active{opacity:.72}.hidden{display:none!important}.screen{display:none}.screen.active{display:block}.seg{display:grid;grid-template-columns:1fr 1fr;background:var(--card2);border:1px solid var(--border);border-radius:14px;padding:4px;gap:4px}.seg button{background:transparent;color:var(--muted);min-height:40px}.seg button.active{background:#fff;color:#111}.bottomnav{position:fixed;z-index:50;left:0;right:0;bottom:0;background:rgba(13,13,15,.94);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border-top:1px solid var(--border);padding:7px 10px calc(7px + env(safe-area-inset-bottom));display:flex;justify-content:center}.navinner{width:min(720px,100%);display:grid;grid-template-columns:repeat(3,1fr);gap:5px}.navbtn{background:transparent;color:var(--muted);padding:7px 4px;min-height:54px;font-size:11px;display:flex;flex-direction:column;align-items:center;gap:3px}.navbtn svg{width:23px;height:23px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.navbtn.active{color:#fff}.search{margin-bottom:10px}.detailitem{background:var(--card2);border-radius:15px;padding:13px;margin:10px 0}.detailtitle{font-size:25px;font-weight:750}.note{white-space:pre-wrap}.count{font-size:12px;color:var(--muted);font-weight:400}.settingtitle{font-size:20px;font-weight:750;margin-bottom:5px}.footer{text-align:center;color:var(--muted);font-size:12px;margin:20px 0}.toast{position:fixed;left:50%;bottom:100px;transform:translateX(-50%);background:#fff;color:#111;padding:10px 14px;border-radius:12px;font-weight:650;z-index:120;box-shadow:0 8px 30px #0008}.modal{position:fixed;inset:0;background:#000a;z-index:80;display:flex;align-items:flex-end;justify-content:center;padding:14px}.modalbox{width:min(720px,100%);max-height:88vh;overflow:auto;background:var(--card);border:1px solid var(--border);border-radius:20px;padding:16px;margin-bottom:env(safe-area-inset-bottom)}.productpick{width:100%;display:flex;align-items:center;justify-content:space-between;text-align:left;background:#17171b;color:var(--text);border:1px solid var(--border);padding:12px 13px}.productpick .meta,.pickeritem .meta{display:block;color:var(--muted);font-size:12px;margin-top:4px}.categorybar{display:flex;gap:8px;overflow:auto;padding:2px 0 10px;scrollbar-width:none}.categorybar::-webkit-scrollbar{display:none}.catbtn{white-space:nowrap;min-height:38px;padding:8px 12px;background:var(--card2);color:var(--muted);border:1px solid var(--border)}.catbtn.active{background:#fff;color:#111;border-color:#fff}.pickerlist{display:grid;gap:8px;margin-top:3px}.pickeritem{display:flex;justify-content:space-between;align-items:center;gap:12px;width:100%;text-align:left;background:var(--card2);color:var(--text);border:1px solid var(--border);padding:12px 13px}.pickeritem.selected{border-color:#fff}.pickerprice{white-space:nowrap;color:var(--good);font-weight:750}.summary{margin-top:14px}.sizeTitle{font-weight:750}.dimresult{margin-top:11px;padding-top:11px;border-top:1px solid var(--border)}.categoryPanel{margin-top:8px;padding-top:12px;border-top:1px solid var(--border)}.categoryHeader{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}.categoryName{font-size:18px;font-weight:750}.emptybox{padding:18px 4px;color:var(--muted);text-align:center}.categoryActions{display:flex;gap:7px;flex-wrap:wrap}.categoryActions button{min-height:38px}.modalActions{display:flex;gap:8px;margin-top:14px}.modalActions button{flex:1}.mutedButton{background:transparent;color:var(--muted);border:1px solid var(--border)}.productEdit{background:var(--card2);border:1px solid var(--border);border-radius:15px;padding:12px;margin:9px 0}.productEditTop{display:grid;grid-template-columns:minmax(0,1fr) 42px;gap:8px}.ch