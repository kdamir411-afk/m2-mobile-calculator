get.value.trim()||`Расчёт ${i+1}`}if(d.farea!==undefined)floorItems[i].area=safe(e.target.value);if(d.fwaste!==undefined)floorItems[i].waste=Math.min(100,safe(e.target.value));if(d.fdiscount!==undefined)floorItems[i].discount=Math.min(100,safe(e.target.value));persist();calcFloor()};
$('floorList').onchange=e=>{const d=e.target.dataset;if(d.flayout===undefined)return;const i=+d.flayout;floorItems[i].layout=e.target.value;floorItems[i].waste=defaultWaste(e.target.value);persist();renderFloor()};
$('floorList').onclick=e=>{const pick=e.target.closest('[data-fpick]'),del=e.target.closest('[data-fdel]'),dup=e.target.closest('[data-fdup]');if(pick){openPicker('floor',+pick.dataset.fpick);return}if(del){floorItems.splice(+del.dataset.fdel,1);if(!floorItems.length)floorItems=[blankFloor()];persist();renderFloor()}else if(dup){const i=+dup.dataset.fdup;floorItems.splice(i+1,0,{...floorItems[i],title:''});persist();renderFloor()}};
$('copyFloor').onclick=()=>copy(textSnapshot(snapshot('floor')));$('saveFloor').onclick=()=>openSave(snapshot('floor'));$('clearFloor').onclick=()=>clearCurrent('floor');
$('addWall').onclick=()=>{wallItems.push(blankWall());persist();renderWalls()};
$('wallList').oninput=e=>{const d=e.target.dataset;let i=d.wtitle??d.wheight??d.wwidth??d.wwaste??d.wdiscount;if(i===undefined)return;i=+i;if(d.wtitle!==undefined){wallItems[i].title=e.target.value;const h=document.querySelector(`[data-whead="${i}"]`);if(h)h.textContent=e.target.value.trim()||`Размеры ${i+1}`}if(d.wheight!==undefined)wallItems[i].height=safe(e.target.value);if(d.wwidth!==undefined)wallItems[i].width=safe(e.target.value);if(d.wwaste!==undefined)wallItems[i].waste=Math.min(100,safe(e.target.value));if(d.wdiscount!==undefined)wallItems[i].discount=Math.min(100,safe(e.target.value));persist();calcWalls()};
$('wallList').onchange=e=>{const d=e.target.dataset;if(d.wlayout===undefined)return;const i=+d.wlayout;wallItems[i].layout=e.target.value;wallItems[i].waste=defaultWaste(e.target.value);persist();renderWalls()};
$('wallList').onclick=e=>{const pick=e.target.closest('[data-wpick]'),del=e.target.closest('[data-wdel]'),dup=e.target.closest('[data-wdup]');if(pick){openPicker('wall',+pick.dataset.wpick);return}if(del){wallItems.splice(+del.dataset.wdel,1);if(!wallItems.length)wallItems=[blankWall()];persist();renderWalls()}else if(dup){const i=+dup.dataset.wdup;wallItems.splice(i+1,0,{...wallItems[i],title:''});persist();renderWalls()}};
$('copyWall').onclick=()=>copy(textSnapshot(snapshot('wall')));$('saveWall').onclick=()=>openSave(snapshot('wall'));$('clearWall').onclick=()=>clearCurrent('wall');
$('pickerSearch').oninput=renderPicker;$('pickerClose').onclick=closePicker;$('productModal').onclick=e=>{if(e.target===$('productModal'))closePicker()};$('historySearch').oninput=renderHistory;$('historyList').onclick=e=>{const r=e.target.closest('[data-hist]');if(r)showDetail(+r.dataset.hist)};$('detailBack').onclick=()=>showTab(lastTab);$('detailContent').onclick=e=>{const c=e.target.closest('[data-copyhist]'),d=e.target.closest('[data-delhist]');if(c){const x=history[+c.dataset.copyhist];if(x&&(x.type==='floor'||x.type==='wall'))copy(textSnapshot(x));else toast('Старая запись')}if(d&&confirm('Удалить этот расчёт?')){h