py(t){try{await navigator.clipboard.writeText(t)}catch{const a=document.createElement('textarea');a.value=t;document.body.appendChild(a);a.select();document.execCommand('copy');a.remove()}toast('Скопировано')}
function openSave(item){pendingSave=item;$('saveName').value='';$('saveNote').value='';$('modal').classList.remove('hidden');setTimeout(()=>$('saveName').focus(),50)}
function finishSave(){if(!pendingSave)return;pendingSave.id=Date.now();pendingSave.name=$('saveName').value.trim()||'Клиент';pendingSave.note=$('saveNote').value.trim();pendingSave.date=new Date().toLocaleString('ru-RU');history.unshift(pendingSave);persist();pendingSave=null;$('modal').classList.add('hidden');toast('Расчёт сохранён')}
function histSummary(x){if(x&&(x.type==='floor'||x.type==='wall'))return{a:safe(x.area),t:safe(x.total)};if(x&&x.type==='manual'&&x.product)return{a:safe(x.area),t:safe(x.total)};if(x&&x.type==='sizes'){let a=0,t=0;(x.sizes||[]).forEach(z=>{const p=z.productSnapshot||productObj(z.product)||{price:0},ar=safe(z.height)*safe(z.width);a+=ar;t+=ar*safe(p.price)*(1-Math.min(100,safe(z.discount))/100)});return{a,t}}return{a:null,t:null}}
function renderHistory(){const q=$('historySearch').value.trim().toLowerCase(),list=$('historyList');list.innerHTML='';$('historyCount').textContent=history.length?history.length+' шт.':'';let shown=0;history.forEach((x,i)=>{const hay=((x.name||'')+' '+(x.note||'')).toLowerCase();if(q&&!hay.includes(q))return;shown++;const s=histSummary(x),d=document.createElement('div');d.className='historyrow';d.dataset.hist=i;d.innerHTML=`<div class="head"><div><div class="pname">${esc(x.name||'Расчёт')}</div><div class="small">${esc(x.date||'')}</div></div><b>›</b></div>${s.a!==null?`<div class="small" style="margin-top:6px">${num(s.a)} м² · ${money(s.t)} ₸</div>`:''}${x.note?`<div class="small" style="margin-top:4px">${esc(x.note)}</div>`:''}`;list.appendChild(d)});if(!shown)list.innerHTML='<div class="small" style="padding:12px 0">'+(history.length?'Ничего не найдено.':'История пока пустая.')+'</div>'}
function showDetail(i){const x=history[i];if(!x)return;lastTab='history';let h=`<div class="detailtitle">${esc(x.name||'Расчёт')}</div><div class="sub">${esc(x.date||'')}</div>`;if(x.note)h+=`<div class="card"><b>Заметка</b><div class="note" style="margin-top:7px">${esc(x.note)}</div></div>`;if(x.type==='floor'||x.type==='wall'){let totalBefore=0,totalDiscount=0,totalAfter=0,totalWasteArea=0;(x.items||[]).forEach((z,j)=>{const p=z.productSnapshot||{name:'',category:'',price:0,packArea:0,layouts:layoutKeys},c=calcSaved(z,x.type);totalBefore+=c.base;totalDiscount+=c.discountSum;totalAfter+=c.total;totalWasteArea+=c.wasteArea;h+=`<div class="detailitem"><b>${esc(z.title||`Размеры ${j+1}`)}</b>${x.type==='wall'?`<div class="line"><span>Размер</span><b>${num(z.height)} × ${num(z.width)} м</b></div>`:''}<div class="line"><span>Площадь</span><b>${num(c.area)} м²</b></div><div class="line"><span>Укладка</span><b>${layoutLabel(c.layout)}</b></div><div class="line"><span>Запас</span><b>${c.waste}%</b></div><div class="line"><span>С запасом</span><b>${num(c.wasteArea)} м²</b></div><div class="line"><span>Товар</span><b>${esc(p.name||'Без названия')}</b></div><div class="line"><span>Цена<