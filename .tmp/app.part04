b)});
  $('productCount').textContent=products.length?`${products.length} шт.`:'0 шт.';const panel=$('categoryPanel');if(!selectedCategory){panel.innerHTML='<div class="emptybox">Категорий пока нет.</div>';return}
  const rows=products.map((p,i)=>({p,i})).filter(x=>(x.p.category||NO_CAT)===selectedCategory);
  panel.innerHTML=`<div class="categoryHeader"><div class="categoryName">${esc(selectedCategory)}</div><div class="categoryActions">${selectedCategory!==NO_CAT?'<button class="secondary" id="renameCategory">Переименовать</button>':''}<button class="danger" id="deleteCategory">Удалить</button></div></div><div id="categoryProducts"></div>`;
  const list=$('categoryProducts');if(!rows.length)list.innerHTML='<div class="emptybox">В этой категории пока нет товаров.</div>';
  rows.forEach(({p,i})=>{const d=document.createElement('div');d.className='productEdit';d.innerHTML=`<div class="productEditTop"><input data-pname="${i}" value="${esc(p.name)}" placeholder="Название товара"><button data-pdel="${i}" class="danger">×</button></div><div class="grid2"><div><label>Цена за 1 м²</label><input data-pprice="${i}" type="number" inputmode="decimal" value="${safe(p.price)}"></div><div><label>м² в упаковке</label><input data-ppack="${i}" type="number" step="0.001" inputmode="decimal" value="${p.packArea?safe(p.packArea):''}" placeholder="Напр. 2.3"></div></div><label>Доступная укладка</label><div class="checkrow">${layoutChecks(p,i)}</div>`;list.appendChild(d)});
  const r=$('renameCategory');if(r)r.onclick=()=>openCategoryModal('rename');$('deleteCategory').onclick=deleteSelectedCategory
}
function readVisibleProducts(){
  document.querySelectorAll('[data-pname]').forEach(el=>{const i=+el.dataset.pname;if(products[i])products[i].name=el.value.trim()});
  document.querySelectorAll('[data-pprice]').forEach(el=>{const i=+el.dataset.pprice;if(products[i])products[i].price=safe(el.value)});
  document.querySelectorAll('[data-ppack]').forEach(el=>{const i=+el.dataset.ppack;if(products[i])products[i].packArea=safe(el.value)});
  const visible=[...document.querySelectorAll('[data-pname]')].map(el=>+el.dataset.pname);visible.forEach(i=>{if(!products[i])return;const checked=[...document.querySelectorAll(`[data-playout="${i}"]:checked`)].map(el=>el.dataset.layout).filter(k=>layoutKeys.includes(k));products[i].layouts=checked.length?checked:[...layoutKeys]})
}
function openCategoryModal(mode){categoryModalMode=mode;$('categoryModalTitle').textContent=mode==='rename'?'Переименовать категорию':'Новая категория';$('categoryNameInput').value=mode==='rename'&&selectedCategory!==NO_CAT?selectedCategory:'';$('categoryModal').classList.remove('hidden');setTimeout(()=>$('categoryNameInput').focus(),50)}
function closeCategoryModal(){$('categoryModal').classList.add('hidden')}
function saveCategory(){const name=$('categoryNameInput').value.trim();if(!name){toast('Укажи название категории');return}if(categoryModalMode==='rename'){const old=selectedCategory;if(old===NO_CAT)return;products.forEach(p=>{if(p.category===old)p.category=name});categoryNames=categoryNames.map(c=>c===old?name:c);categoryNames=[...new Set(categoryNames)];selectedCategory=name}else{if(!categoryNames.includes(name))categoryNames.push(name);selectedCategory=name}persist();closeCategoryModal();renderSettings();renderCalc()}
function deleteSelectedCategory(){if(!selectedCategory)return;const count=products.filter(p=>(p.category||NO_CAT)===selectedCategory).length;if(!confirm(count?`Удалить категорию и ${count} товар(а/ов)?`:'Удалить категорию?'))return;const oldProducts=products;const keep=[];const indexMap=new Map();oldProducts.forEach((p,i)=>{if((p.category||NO_CAT)!==selectedCategory){indexMap.set(i,keep.length);keep.push(p)}});products=keep;[floorItems,wallItems].forEach(arr=>arr.forEach(x=>{x.product=indexMap.has(x.product)?indexMap.get(x.product):-1}));if(selectedCategory!==NO_CAT)categoryNames=categoryNames.filter(c=>c!==selectedCategory);selectedCategory=actualCategories()[0]||'';persist();renderSettings();renderCalc()}
function openNewProduct(){readVisibleProducts();const hasCat=!!selectedCategory;$('newProductCategoryWrap').classList.toggle('hidden',hasCat);$('newProductCategory').value='';$('newProductName').value='';$('newProductPrice').value='0';$('newProductPack').value='';$('newLayoutStraight').checked=true;$('newLayoutDeck').checked=true;$('newLayoutHerringbone').checked=true;$('newProductModal').classList.remove('hidden');setTimeout(()=>$(hasCat?'newProductName':'newProductCategory').focus(),50)}
function closeNewProduct(){$('newProductModal').classList.add('hidden')}
function saveNewProduct(){let cat=selectedCategory;if(!cat){cat=$('newProductCategory').value.trim();if(!cat){toast('Укажи категорию');return}if(!categoryNames.includes(cat))categoryNames.push(cat);selectedCategory=cat}const name=$('newProductName').value.trim();if(!name){toast('Укажи название товара');return}const layouts=[];if($('newLayoutStraight').checked)layouts.push('straight');if($('newLayoutDeck').checked)layouts.push('deck');if($('newLayoutHerringbone').checked)layouts.push('herringbone');if(!layouts.length){toast('Выбери хотя бы один тип укладки');return}const storedCat=cat===NO_CAT?'':cat;products.push({category:storedCat,name,price:safe($('newProductPrice').value),packArea:safe($('newProductPack').value),layouts});persist();closeNewProduct();renderSettings();renderCalc()}
function calcCore(area,p,layout,waste,discount){area=safe(area);waste=Math.min(100,safe(waste));discount=Math.min(100,safe(discount));const wasteArea=area*(1+waste/100),packArea=safe(p?.packArea),packages=packArea>0&&wasteArea>0?Math.ceil((wasteArea-1e-9)/packArea):0,actualArea=packArea>0?packages*packArea:wasteArea,base=actualArea*safe(p?.price),discountSum=base*discount/100,total=base-discountSum;return{p,area,layout,waste,wasteArea,packArea,packages,actualArea,base,discount,discountSum,total}}
function floorCalc(x){return calcCore(safe(x.area),productObj(x.product),x.layout,x.waste,x.discount)}
function wallCalc(x){return calcCore(safe(x.height)*safe(x.width),productObj(x.product),x.layout,x.waste,x.discount)}
function layoutOptions(p,current){const allowed=normalizeLayouts(p?.layouts);return allowed.map(k=>`<option value="${k}" ${k===current?'selected':''}>${LAYOUTS[k].label}</option>`).join('')}
function calcResultHtml(c,prefix,i){const packKnown=c.p&&c.packArea>0;return `<div class="resultgrid"><div class="resultbox"><span>Площадь с запасом</span><b data-${prefix}warea="${i}"