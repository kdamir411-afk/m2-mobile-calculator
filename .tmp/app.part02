eckrow{display:flex;gap:7px;flex-wrap:wrap;margin-top:7px}.checkpill{display:flex;align-items:center;gap:7px;border:1px solid var(--border);border-radius:11px;padding:8px 10px;color:var(--muted);font-size:13px;margin:0}.checkpill input{width:18px;min-height:18px;height:18px;padding:0;margin:0}.calcHint{margin-top:8px;padding:9px 10px;border:1px solid var(--border);border-radius:12px;color:var(--muted);font-size:12px}.warn{color:#ffcc7a}.resultgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}.resultbox{background:#17171b;border-radius:12px;padding:10px}.resultbox span{display:block;color:var(--muted);font-size:11px;margin-bottom:4px}.resultbox b{font-size:15px}.modalCheck{margin:5px 0 12px}.modalCheck .checkrow{margin-top:8px}
@media(max-width:520px){.grid2,.resultgrid{grid-template-columns:1fr 1fr}}
</style>
</head>
<body><main>
<section id="calcScreen" class="screen active">
<h1>Калькулятор</h1><div class="sub">Расчёт площади, запаса и количества упаковок.</div>
<div id="manualCalc"><div id="floorList"></div><button id="addFloor" class="secondary">+ Добавить расчёт</button><div class="card summary"><div class="line"><span>Общая площадь</span><b id="floorArea">0 м²</b></div><div class="line"><span>С учётом запаса</span><b id="floorWasteArea">0 м²</b></div><div class="line"><span>Итого</span><b id="floorTotal" class="final">0 ₸</b></div><div class="actions"><button id="copyFloor" class="secondary">Скопировать</button><button id="saveFloor">Сохранить</button><button id="clearFloor" class="trash" aria-label="Очистить"></button></div></div></div>
<div id="dimensionCalc" class="hidden"><div id="wallList"></div><button id="addWall" class="secondary">+ Добавить размеры</button><div class="card summary"><div class="line"><span>Общая площадь</span><b id="wallArea">0 м²</b></div><div class="line"><span>С учётом запаса</span><b id="wallWasteArea">0 м²</b></div><div class="line"><span>Итого</span><b id="wallTotal" class="final">0 ₸</b></div><div class="actions"><button id="copyWall" class="secondary">Скопировать</button><button id="saveWall">Сохранить</button><button id="clearWall" class="trash" aria-label="Очистить"></button></div></div></div>
</section>
<section id="historyScreen" class="screen"><h1>История</h1><div class="sub">Сохранённые расчёты клиентов.</div><input id="historySearch" class="search" type="search" placeholder="Поиск по имени или заметке"><div class="card"><div class="head"><b>Расчёты</b><span id="historyCount" class="count"></span></div><div id="historyList"></div></div></section>
<section id="settingsScreen" class="screen"><h1>Настройки</h1><div class="sub">Настрой калькулятор один раз — дальше только считай.</div><div class="card"><div class="settingtitle">Способ расчёта</div><div class="small" style="margin-bottom:12px">Выбери, что будет открываться в калькуляторе.</div><div class="seg"><button id="setManual">По площади</button><button id="setDimension">Высота × ширина</button></div></div><div class="card"><div class="head"><div><div class="settingtitle">Товары и цены</div><div class="small">У товара укажи цену за м², метраж упаковки и доступные типы укладки.</div></div><span id="productCount" class="count"></span></div><div id="settingsCategories" class="categorybar" style="margin-top:12px"></div><div id="categoryPanel" class="categoryPanel"></div><div class="actions"><button id="addCategory" class="secondary">+ Категория</button><button id="addProduct" class="secondary">+ Добавить товар</button><button id="saveProducts">Сохранить</button></div></div><div class="footer">Настройки и история хранятся на этом устройстве.</div></section>
<section id="detailScreen" class="screen"><button id="detailBack" class="secondary">← Назад</button><div id="detailContent" style="margin-top:15px"></div></section>
</main>
<nav class="bottomnav" id="bottomNav"><div class="navinner"><button class="navbtn active" data-tab="calc"><svg viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M8 6h8M8 11h2M14 11h2M8 15h2M14 15h2M8 19h2M14 19h2"/></svg><span>Калькулятор</span></button><button class="navbtn" data-tab="history"><svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5M12 7v5l3 2"/></svg><span>История</span></button><button class="navbtn" data-tab="settings"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1a1.7 1.7 0 0 0 1.9.3A1.7 1.7 0 0 0 10 3V2.8h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1z"/></svg><span>Настройки</span></button></div></nav>
<div id="modal" class="modal hidden"><div class="modalbox"><div class="settingtitle">Сохранить расчёт</div><label>Имя клиента / название</label><input id="saveName"><label>Заметка (необязательно)</label><textarea id="saveNote"></textarea><div class="modalActions"><button id="modalCancel" class="secondary">Отмена</button><button id="modalSave">Сохранить</button></div></div></div>
<div id="productModal" class="modal hidden"><div class="modalbox"><div class="head"><div><div class="settingtitle">Выбор товара</div><div class="small">Выбери категорию или найди товар.</div></div><button id="pickerClose" class="secondary">Закрыть</button></div><label>Поиск</label><input id="pickerSearch" type="search"><div id="pickerCategories" class="categorybar" style="margin-top:10px"></div><div id="pickerList" class="pickerlist"></div></div></div>
<div id="categoryModal" class="modal hidden"><div class="modalbox"><div id="categoryModalTitle" class="settingtitle">Категория</div><label>Название категории</label><input id="categoryNameInput"><div class="modalActions"><button id="categoryCancel" class="secondary">Отмена</button><button id="categorySave">Сохранить</button></div></div></div>
<div id="newProductModal" class="modal hidden"><div class="modalbox"><div class="settingtitle">Добавить товар</div><div id="newProductCategoryWrap"><label>Категория</label><input id="newProductCategory"></div><label>Название товара</label><input id="newProductName"><div class="grid2"><div><label>Цена за 1 м²</label><input id="newProductPrice" type="number" inputmode="decimal" value="0"></div><div><label>м² в упаковке</label><input id="newProductPack"